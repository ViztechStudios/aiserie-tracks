{
  "expo": {
    "name": "Aiserie Tracks",
    "slug": "aiserie-tracks",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F3EA",
    "ios": {
      "bundleIdentifier": "com.aiserie.tracks",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aiserie Tracks uses the camera to scan grocery receipts. Photos are processed on your device only."
      }
    },
    "android": {
      "package": "com.aiserie.tracks",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#07172B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Aiserie Tracks",
      "shortName": "Aiserie",
      "lang": "en",
      "themeColor": "#0C2E44",
      "backgroundColor": "#F7F3EA",
      "description": "Personal finance tracker — budgets, wallets and receipts, all on your device."
    },
    "experiments": {
      "baseUrl": "/aiserie-tracks"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07172B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aiserie Tracks to use the camera to scan your grocery receipts.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 33
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7009b2cc-4608-463b-b903-cc7b0e9fbda8"
      }
    },
    "owner": "viztechstudiosss"
  }
}
